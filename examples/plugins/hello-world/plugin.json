{
  "id": "hello-world",
  "name": "Hello World",
  "version": "0.3.0",
  "description": "The smallest possible aish plugin — contributes a single greeting skill to prove plugin discovery and skill-registry expansion work end to end.",
  "enabled": true,
  "provides": {
    "login": "hello-world"
  },
  "webhook_command": "echo '👋 hello-world: webhook received' && cat > /tmp/hello-world-event.json",
  "webhooks": [
    {
      "event_type": "ping",
      "command": ["handlers/greet.sh"],
      "timeout_secs": 10
    },
    {
      "event_type": "issues",
      "command": ["handlers/greet.sh"],
      "timeout_secs": 10
    }
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "greeting": { "type": "string", "default": "Hello, World!" },
      "shout": { "type": "boolean", "default": false },
      "greeter": { "type": "string", "default": "${env:USER}" }
    }
  }
}
