{
  "mcpServers": {
    "atum": {
      "type": "http",
      "url": "https://events.api.getatum.com/v1/tenants/${ATUM_TENANT}/projects/${ATUM_PROJECT}/mcp",
      "headers": {
        "X-Atum-Api-Key": "${ATUM_API_KEY}",
        "X-Atum-Api-Key-Id": "${ATUM_API_KEY_ID}"
      },
      "credentials": {
        "file": "~/.atum/credentials",
        "profile": "aish"
      }
    }
  }
}
