# Deployment — env file for the systemd unit (copy to /etc/aish-broker/broker.env)
BROKER_LISTEN=0.0.0.0:8080
BROKER_DB=/var/lib/aish-broker/aish-broker.db
BROKER_MAX_QUEUE_SIZE=1000
BROKER_WS_HEARTBEAT_SECS=30
BROKER_POLL_TIMEOUT_SECS=60
BROKER_MSG_TTL_SECS=604800
BROKER_LOG_LEVEL=info
# Log format: text (default) or json (one object per line, for log collectors)
#LOG_FORMAT=json
# OpenTelemetry metrics → SigNoz / any OTLP collector (unset = disabled).
# See deploy/signoz/README.md for metric names and the dashboard.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<key>
#OTEL_SERVICE_NAME=aish-webhook-broker
#OTEL_METRIC_EXPORT_INTERVAL=60000
