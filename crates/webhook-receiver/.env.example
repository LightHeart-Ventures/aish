# Webhook Receiver Configuration

# SQLite database path (local dev)
DATABASE_URL=sqlite:webhooks.db

# Secret key for HMAC-SHA256 signature verification
# Change this to a strong random value in production
WEBHOOK_SECRET=dev-secret-change-in-production

# HTTP server port
PORT=8080

# Log level (debug, info, warn, error)
RUST_LOG=webhook_receiver=info
