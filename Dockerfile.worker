# Dockerfile.worker — the container image background workers run in (S9.1).
#
# A background "worker" is `aish` re-exec'd in `--coordinator` mode. The
# container backend (src/container.rs) runs that same binary inside this image
# instead of as a host subprocess, giving each worker hermetic, rootless
# execution with a mounted state volume (/aish/state) and a project tree bind
# at the workdir (/aish/work).
#
# The `aish` binary is INJECTED from the build context (`target/release/aish`),
# baked as a layer for a release image or bind-mounted over in dev. Build it via
# `make worker-image` (which runs `cargo build --release` first).
#
# Caveat (cross-arch / libc): the injected binary must match the image's
# platform + libc. A glibc host build (debian/bookworm-slim base) matches a
# glibc host; building the image on macOS requires a linux/amd64|arm64 aish
# build (e.g. cross or a CI runner) — the host Darwin binary will NOT run here.
# This is why the container backend degrades to the host subprocess (AC9) when
# the image is missing or unbuildable.

FROM debian:bookworm-slim

# git is needed by the coordinator's worktree/VCS tooling; ca-certificates for
# HTTPS (MCP servers, gh, crates). Slim base keeps the image ≤ ~250 MB (AC perf).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Inject the aish binary (baked layer for release; bind-mount in dev). The path
# is relative to the build context (the repo root).
ARG AISH_BIN=target/release/aish
COPY ${AISH_BIN} /usr/local/bin/aish
RUN chmod 0755 /usr/local/bin/aish

# Fixed mount points: the persistent state volume (AC4) and the project tree.
RUN mkdir -p /aish/state /aish/work
WORKDIR /aish/work

# Nested-coordinator guard holds inside the container too: an in-container aish
# must never spawn its own workers (the env-file also sets this, belt + braces).
ENV AISH_COORDINATOR=1

# The container command is the coordinator argv supplied at `run` time
# (`-c <task> --coordinator --run-id <id> …`), so aish is the entrypoint.
ENTRYPOINT ["/usr/local/bin/aish"]
