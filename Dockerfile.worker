# Dockerfile.worker — the container image background workers run in (S9.1).
#
# A background "worker" is `aish` re-exec'd in `--coordinator` mode. The
# container backend (src/container.rs) runs that same binary inside this image
# instead of as a host subprocess, giving each worker hermetic, rootless
# execution with a mounted state volume (/aish/state) and a project tree bind
# at the workdir (/aish/work).
#
# ─── libc compatibility (why this is a MULTI-STAGE self-build) ───────────────
# Historically this file `COPY`ed the HOST-built `target/release/aish` into the
# runtime image. That coupled the runtime to the *host's* glibc: a binary built
# on a modern host (e.g. Ubuntu 24.04 → glibc 2.39) will NOT run on the
# debian:bookworm-slim base (glibc 2.36) — it dies at exec with
#   /lib/x86_64-linux-gnu/libc.so.6: version `GLIBC_2.39' not found
# Worse, the image *builds* successfully (the COPY works); it only fails when a
# worker container is launched — so the host-fallback safety net in
# `build_container_command` (which only triggers on a MISSING/unbuildable image)
# never catches it, and the operator just sees failed background jobs.
#
# The fix: build the binary INSIDE the image, against the SAME base's glibc, so
# the runtime libc always matches the compiled binary regardless of the
# operator's host distro. `container.rs` additionally runs a one-shot
# `<engine> run --rm <tag> --version` compat probe before committing a worker to
# the container path, so even a hand-injected mismatched binary degrades to the
# host subprocess with a clear diagnostic instead of hard-failing (belt + braces).
#
# ─── builder stage ───────────────────────────────────────────────────────────
# Pinned to the bookworm-based Rust image so the builder's glibc == the runtime
# base's glibc. Claude-only build (`--no-default-features`) — the heavy `local`
# (llama.cpp / cmake) feature is never needed by a coordinator worker and only
# adds compile time + build deps (see scripts/build.sh / Makefile build-fast).
FROM rust:1-bookworm AS builder

WORKDIR /src

# `wreq` (browser-impersonating HTTP client) pulls in `btls-sys`, which compiles
# BoringSSL from source via cmake on EVERY build config — `--no-default-features`
# does not skip it. gcc/g++ ship in rust:1-bookworm but cmake does not, so the
# build fails with `is cmake not installed?` (exit 101) without this. (`perl` is
# also a BoringSSL codegen dep but is already present in the base image.)
RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake \
    && rm -rf /var/lib/apt/lists/*

# The `.cargo/config.toml` in the context carries the per-build `jobs` cap, so
# the in-image compile inherits the same OOM mitigation as host/worktree builds.
# `.dockerignore` keeps the context lean (no target/, .git, worktrees).
COPY . .

# Claude-only, stripped release build (profile.release: opt-level=2, thin LTO,
# strip). Matches the coordinator/CI build policy exactly.
RUN cargo build --release --no-default-features --locked \
    && cp target/release/aish /aish-bin \
    && /aish-bin --version

# ─── runtime stage ───────────────────────────────────────────────────────────
FROM debian:bookworm-slim

# Runtime toolchain a coordinator worker actually shells out to. A worker is a
# full aish coordinator: it opens PRs and reads CI (`gh`), fetches over HTTP
# (`curl`), runs helper scripts (`python3`), and drives git in its worktree
# (`git` + `openssh-client` for ssh remotes). `jq` pairs with `gh --json`;
# `ca-certificates` anchors TLS (MCP over HTTPS, crates, gh); `less` is the
# default git/gh pager; `gnupg` is only needed to verify the GitHub CLI apt key.
#
# `gh` is NOT in Debian bookworm's repos, so we add GitHub's apt source (their
# documented install path) rather than pinning a downloaded .deb.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git ca-certificates curl python3 jq openssh-client less gnupg \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
         -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
         > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# The worker's project tree is a git WORKTREE bind-mounted from the host, owned
# by the host uid but read by root in the container — git 2.35.2+ refuses such a
# repo with "detected dubious ownership" and aborts every VCS op. The container
# is a single-tenant hermetic sandbox, so globally trust any worktree path.
# (NOTE: this does NOT fix the gitlink itself — a worktree's `.git` file points
#  at the parent repo's `.git/worktrees/<id>` OUTSIDE the /aish/work mount, so
#  git in-container still needs that commondir mounted; tracked separately.)
RUN git config --system --add safe.directory '*'

# The binary built above shares this stage's glibc, so it always runs here.
COPY --from=builder /aish-bin /usr/local/bin/aish
RUN chmod 0755 /usr/local/bin/aish \
    && /usr/local/bin/aish --version

# Fixed mount points: the persistent state volume (AC4) and the project tree.
RUN mkdir -p /aish/state /aish/work
WORKDIR /aish/work

# Nested-coordinator guard holds inside the container too: an in-container aish
# must never spawn its own workers (the env-file also sets this, belt + braces).
ENV AISH_COORDINATOR=1

# The container command is the coordinator argv supplied at `run` time
# (`-c <task> --coordinator --run-id <id> …`), so aish is the entrypoint.
ENTRYPOINT ["/usr/local/bin/aish"]
